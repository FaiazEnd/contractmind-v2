# ContractMind v2.0 Environment Configuration
# Copy to .env and populate keys as needed. Never commit real keys.

APP_NAME=ContractMind v2.0
APP_VERSION=2.0.0
DEBUG=false

# Database & Vector Storage
DATABASE_URL=sqlite+aiosqlite:///./contractmind.db
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads

# Multi-Provider LLM Gateway (leave blank to use deterministic legal simulator fallback)
DEFAULT_LLM_PROVIDER=simulator
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Security
SECRET_KEY=change-this-in-production-use-a-long-random-string
CORS_ORIGINS=*
