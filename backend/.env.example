# ContractMind v2.0 Environment Configuration
# Copy to .env and fill in optional provider keys.
# Never commit real API keys to version control.

APP_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string

# LLM Provider Configuration (auto-falls back to deterministic simulator if unset/offline)
DEFAULT_LLM_PROVIDER=simulator
DEFAULT_LLM_MODEL=gemini-3.5-flash-lite

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Storage Paths (overridden automatically to /tmp when VERCEL=1)
DATABASE_URL=sqlite+aiosqlite:///./data/contractmind.db
UPLOAD_DIR=./data/uploads
CHROMA_PERSIST_DIR=./data/chroma
EXPORT_DIR=./data/exports
